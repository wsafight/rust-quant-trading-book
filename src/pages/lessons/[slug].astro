---
import { getCollection, render } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';
import { CURRICULUM } from '../../data/curriculum';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const meta = CURRICULUM.find((c) => c.slug === lesson.id);
---

<LessonLayout
  slug={lesson.id}
  lessonNumber={lesson.data.lessonNumber}
  lessonCode={lesson.data.lessonCode ?? meta?.lessonCode ?? String(lesson.data.lessonNumber).padStart(2, '0')}
  stage={lesson.data.stage}
  stageName={lesson.data.stageName}
  title={lesson.data.title}
  subtitle={lesson.data.subtitle}
  readMinutes={lesson.data.readMinutes}
  quantFocus={lesson.data.quantFocus}
  labName={lesson.data.labName}
  rustChapterSlug={lesson.data.rustChapterSlug ?? meta?.rustChapterSlug}
  rustChapterTitle={lesson.data.rustChapterTitle ?? meta?.rustChapterTitle}
>
  <Content />
</LessonLayout>
