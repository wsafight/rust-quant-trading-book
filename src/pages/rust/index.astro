---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandIcon from '../../components/ui/BrandIcon.astro';
import { RUST_CURRICULUM, RUST_PARTS } from '../../data/rustCurriculum';
import { withBase } from '../../lib/url';

const totalChapters = RUST_CURRICULUM.length;
---

<BaseLayout
  title="Rust 量化系统代码实战"
  description="14 章浏览器在线点读的 Rust 量化交易引擎实战书：无需本地安装环境，直接通过高亮语法点读与设计测验掌握高可靠交易架构"
>
  <!-- Top Bar -->
  <header class="sticky top-0 z-40 border-b border-slate-200/80 dark:border-slate-800/80 bg-slate-50/85 dark:bg-[#0b1017]/85 backdrop-blur-md">
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6 gap-2">
      <a href={withBase('/rust')} class="flex items-center gap-2.5 font-bold tracking-tight text-slate-900 dark:text-white">
        <BrandIcon class="h-7 w-7 shrink-0" />
        <span>QuantLab · Rust 量化系统代码实战</span>
      </a>
      <div class="flex items-center gap-2">
        <div class="hidden lg:flex items-center rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 p-0.5 text-xs">
          <a
            href={withBase('/')}
            class="rounded-md px-2.5 py-1 font-medium text-slate-500 hover:text-emerald-600 dark:hover:text-emerald-300 transition-colors"
          >
            交易主书
          </a>
          <a
            href={withBase('/rust')}
            class="rounded-md bg-amber-500/15 px-2.5 py-1 font-semibold text-amber-700 dark:text-amber-300"
          >
            Rust 实战书
          </a>
        </div>
        <button
          type="button"
          onclick="window.__openQuantPalette('search')"
          class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 px-2.5 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 hover:border-amber-500/40 transition-colors cursor-pointer"
        >
          <span>搜索</span>
          <kbd class="hidden sm:inline rounded bg-slate-200/70 dark:bg-slate-800 px-1 py-0.5 font-mono text-[10px]">⌘K</kbd>
        </button>
        <button
          type="button"
          onclick="window.__openQuantPalette('rust-map')"
          class="hidden md:inline-flex items-center rounded-lg border border-amber-500/30 bg-amber-500/10 px-2.5 py-1.5 text-xs font-medium text-amber-700 dark:text-amber-300 hover:border-amber-500/60 transition-colors cursor-pointer"
        >
          Rust 图谱
        </button>
        <button
          type="button"
          onclick="window.__toggleQuantTheme()"
          class="inline-flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 px-2.5 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 hover:border-amber-500/40 transition-colors cursor-pointer"
        >
          <span class="dark:hidden">深色</span>
          <span class="hidden dark:inline">浅色</span>
        </button>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4 sm:px-6 py-12 space-y-14">
    <!-- Hero -->
    <section class="relative overflow-hidden rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-[#0f1621] p-7 sm:p-10 shadow-sm">
      <div class="max-w-3xl">
        <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-700 dark:text-amber-300 mb-5">
          <span>伴生工程书 · 全 {totalChapters} 章</span>
          <span class="opacity-40">·</span>
          <span>在线语法点读</span>
          <span class="opacity-40">·</span>
          <span>无需本地安装 Rust</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
          用 Rust 把实盘交易的致命 Bug，<br class="hidden sm:inline" />
          直接焊死在编译期。
        </h1>

        <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
          这是《零基础量化交易交互指南》的独立代码实战伴生书。全书 4 大篇、{totalChapters} 章全部采用<strong>自包含在线交互代码卡</strong>——
          直接在网页里点击高亮语法（如 Newtype、BTreeMap、穷尽 match、i128、BinaryHeap、Const Generics）看它究竟挡住了哪一类实盘事故，不需要配置本地环境。
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href={withBase('/rust/r01-domain-modeling')}
            class="inline-flex items-center gap-2 rounded-xl bg-amber-600 hover:bg-amber-500 px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors"
          >
            开始 R01：强类型领域建模与零浮点刻度 →
          </a>
          <a
            href={withBase('/')}
            class="inline-flex items-center gap-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 hover:border-emerald-500/60 px-4 py-3 text-sm font-semibold text-emerald-700 dark:text-emerald-300 transition-colors"
          >
            ← 回到《零基础量化交易交互指南》
          </a>
        </div>
      </div>

      <!-- Progress Strip -->
      <div class="mt-8 pt-6 border-t border-slate-200/80 dark:border-slate-800/80 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-slate-200/70 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/50 p-4">
          <div class="text-xs text-slate-500">已完成 Rust 实战章</div>
          <div id="rust-home-done" class="mt-1 font-mono text-2xl font-bold text-amber-600 dark:text-amber-400 tabular-nums">
            0 / {totalChapters}
          </div>
        </div>
        <div class="rounded-xl border border-slate-200/70 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/50 p-4 flex items-center justify-between gap-2">
          <div>
            <div class="text-xs text-slate-500">已点读 Rust 语法点</div>
            <div id="rust-home-concepts" class="mt-1 font-mono text-2xl font-bold text-emerald-600 dark:text-emerald-400 tabular-nums">
              0 项
            </div>
          </div>
          <button
            id="rust-home-reset"
            type="button"
            class="shrink-0 rounded-lg border border-slate-200 dark:border-slate-700 px-2.5 py-1 text-[11px] font-medium text-slate-500 hover:text-rose-500 hover:border-rose-500/40 transition-colors cursor-pointer"
          >
            重置进度
          </button>
        </div>
      </div>
    </section>

    <!-- 14-Chapter Roadmap -->
    <section class="space-y-8">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          全书 4 大篇 · {totalChapters} 章工程架构路线
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
          从零浮点领域类型、L2 订单簿、双式账本，到撮合队列、OMS 状态机、独立风控、Tokio 背压与期权算法库。
        </p>
      </div>

      <div class="space-y-8">
        {RUST_PARTS.map((pt) => {
          const items = RUST_CURRICULUM.filter((c) => c.part === pt.part);
          return (
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/60 dark:bg-slate-900/30 p-5 sm:p-6">
              <div class="mb-4">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
                    Part 0{pt.part}
                  </span>
                  <h3 class="text-lg font-bold text-slate-900 dark:text-white">{pt.name}</h3>
                </div>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">{pt.tagline}</p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
                {items.map((chapter) => (
                  <a
                    href={withBase(`/rust/${chapter.slug}`)}
                    class="group flex flex-col justify-between rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f1621] p-4 hover:border-amber-500/50 hover:shadow-sm transition-all"
                  >
                    <div>
                      <div class="flex items-center justify-between gap-2 mb-2">
                        <span class="font-mono text-xs font-bold text-amber-600 dark:text-amber-400">
                          {chapter.chapterCode}
                        </span>
                        <span
                          data-rust-home-badge={chapter.slug}
                          class="text-[11px] font-mono text-slate-400"
                        >
                          {chapter.readMinutes} min
                        </span>
                      </div>
                      <h4 class="font-bold text-slate-900 dark:text-slate-100 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                        {chapter.title}
                      </h4>
                      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
                        {chapter.subtitle}
                      </p>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-1">
                      {chapter.rustConcepts.map((rc) => (
                        <span class="rounded bg-amber-500/10 border border-amber-500/20 px-1.5 py-0.5 font-mono text-[10px] text-amber-700 dark:text-amber-300">
                          {rc}
                        </span>
                      ))}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </main>

  <script>
    import { loadProgress, resetProgress, PROGRESS_EVENT } from '../../lib/progress';
    import { RUST_CURRICULUM } from '../../data/rustCurriculum';

    const total = RUST_CURRICULUM.length;
    const doneEl = document.getElementById('rust-home-done');
    const conceptsEl = document.getElementById('rust-home-concepts');
    const resetBtn = document.getElementById('rust-home-reset');

    const render = () => {
      const p = loadProgress();
      const doneCount = p.completedRustChapters.filter((s) =>
        RUST_CURRICULUM.some((c) => c.slug === s),
      ).length;
      if (doneEl) doneEl.textContent = `${doneCount} / ${total}`;
      if (conceptsEl) conceptsEl.textContent = `${p.exploredRustConcepts.length} 项`;

      document.querySelectorAll<HTMLElement>('[data-rust-home-badge]').forEach((el) => {
        const slug = el.dataset.rustHomeBadge || '';
        const item = RUST_CURRICULUM.find((c) => c.slug === slug);
        if (p.completedRustChapters.includes(slug)) {
          el.textContent = '✓ 已完成';
          el.classList.remove('text-slate-400');
          el.classList.add('text-amber-600', 'dark:text-amber-400', 'font-semibold');
        } else if (item) {
          el.textContent = `${item.readMinutes} min`;
          el.classList.add('text-slate-400');
          el.classList.remove('text-amber-600', 'dark:text-amber-400', 'font-semibold');
        }
      });
    };

    resetBtn?.addEventListener('click', () => {
      if (window.confirm('确认清空本机所有学习进度吗？')) {
        resetProgress();
        render();
      }
    });

    window.addEventListener(PROGRESS_EVENT, render);
    render();
  </script>
</BaseLayout>
