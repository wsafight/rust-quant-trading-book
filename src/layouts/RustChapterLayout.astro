---
import BaseLayout from './BaseLayout.astro';
import BrandIcon from '../components/ui/BrandIcon.astro';
import { RUST_CURRICULUM, RUST_PARTS } from '../data/rustCurriculum';
import { withBase } from '../lib/url';

interface Props {
  slug: string;
  chapterNumber: number;
  chapterCode: string;
  part: number;
  partName: string;
  title: string;
  subtitle: string;
  readMinutes: number;
  rustConcepts: string[];
  engineeringGoal: string;
  quantLessonSlug?: string;
  quantLessonTitle?: string;
}

const props = Astro.props;
const currentIndex = RUST_CURRICULUM.findIndex((c) => c.slug === props.slug);
const prevChapter = currentIndex > 0 ? RUST_CURRICULUM[currentIndex - 1] : null;
const nextChapter =
  currentIndex >= 0 && currentIndex < RUST_CURRICULUM.length - 1
    ? RUST_CURRICULUM[currentIndex + 1]
    : null;
---

<BaseLayout title={`${props.chapterCode}：${props.title} · Rust 实战书`} description={props.subtitle}>
  <!-- Top Reading Progress Bar -->
  <div class="fixed top-0 left-0 right-0 z-50 h-0.5 bg-transparent">
    <div
      id="reading-progress-bar"
      class="h-full w-0 bg-gradient-to-r from-amber-500 via-orange-400 to-rose-500 transition-[width] duration-75"
    >
    </div>
  </div>

  <!-- Sticky Header -->
  <header class="sticky top-0 z-40 border-b border-slate-200/80 dark:border-slate-800/80 bg-slate-50/85 dark:bg-[#0b1017]/85 backdrop-blur-md">
    <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 gap-2">
      <div class="flex items-center gap-3 min-w-0">
        <a
          href={withBase('/rust')}
          class="flex items-center gap-2 font-bold tracking-tight text-slate-900 dark:text-white hover:text-amber-600 dark:hover:text-amber-400 transition-colors shrink-0"
        >
          <BrandIcon class="h-7 w-7 shrink-0" />
          <span class="hidden sm:inline">Rust 实战书</span>
        </a>
        <span class="text-slate-300 dark:text-slate-700">/</span>
        <span class="truncate text-sm text-slate-600 dark:text-slate-400">
          {props.chapterCode} · {props.title}
        </span>
      </div>

      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <!-- Dual-book Switcher -->
        <div class="hidden xl:flex items-center rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 p-0.5 text-xs">
          <a
            href={withBase('/')}
            class="rounded-md px-2.5 py-1 font-medium text-slate-500 hover:text-emerald-600 dark:hover:text-emerald-300 transition-colors"
          >
            交易主书
          </a>
          <a
            href={withBase('/rust')}
            class="rounded-md bg-amber-500/15 px-2.5 py-1 font-semibold text-amber-700 dark:text-amber-300"
          >
            Rust 实战书
          </a>
        </div>

        <button
          id="rust-mobile-toc-btn"
          type="button"
          class="lg:hidden inline-flex items-center gap-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 px-2.5 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-200 hover:border-amber-500/40 transition-colors cursor-pointer"
        >
          <span>目录</span>
        </button>
        <button
          type="button"
          onclick="window.__openQuantPalette('search')"
          class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 px-2.5 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 hover:border-amber-500/40 transition-colors cursor-pointer"
        >
          <span>搜索</span>
          <kbd class="hidden sm:inline rounded bg-slate-200/70 dark:bg-slate-800 px-1 py-0.5 font-mono text-[10px]">⌘K</kbd>
        </button>
        <button
          type="button"
          onclick="window.__openQuantPalette('rust-map')"
          class="hidden md:inline-flex items-center rounded-lg border border-amber-500/30 bg-amber-500/10 px-2.5 py-1.5 text-xs font-medium text-amber-700 dark:text-amber-300 hover:border-amber-500/60 transition-colors cursor-pointer"
        >
          Rust 图谱
        </button>
        <button
          id="focus-mode-btn"
          type="button"
          class="hidden lg:inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 px-2.5 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 hover:border-amber-500/40 transition-colors cursor-pointer"
        >
          <span>专注模式</span>
        </button>
        <button
          type="button"
          onclick="window.__toggleQuantTheme()"
          class="inline-flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 px-2.5 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 hover:border-amber-500/40 transition-colors cursor-pointer"
        >
          <span class="dark:hidden">深色</span>
          <span class="hidden dark:inline">浅色</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile TOC Drawer -->
  <div id="rust-mobile-toc-drawer" class="fixed inset-0 z-50 hidden lg:hidden">
    <div id="rust-mobile-toc-backdrop" class="absolute inset-0 bg-slate-950/60 backdrop-blur-xs"></div>
    <div class="relative z-10 h-full w-80 max-w-[85vw] overflow-y-auto border-r border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#0b1017] p-4 shadow-2xl">
      <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-200 dark:border-slate-800">
        <span class="text-sm font-bold text-slate-900 dark:text-white">Rust 实战书 · {RUST_CURRICULUM.length} 章</span>
        <button
          id="rust-mobile-toc-close"
          type="button"
          class="rounded-lg border border-slate-200 dark:border-slate-700 px-2 py-1 text-xs text-slate-500 cursor-pointer"
        >
          关闭
        </button>
      </div>
      <div class="mb-4 flex gap-1.5 text-xs">
        <a href={withBase('/')} class="flex-1 text-center rounded-lg border border-slate-200 dark:border-slate-800 py-1.5 font-medium text-slate-600 dark:text-slate-300">
          交易主书
        </a>
        <a href={withBase('/rust')} class="flex-1 text-center rounded-lg bg-amber-500/15 py-1.5 font-semibold text-amber-700 dark:text-amber-300">
          Rust 实战书
        </a>
      </div>
      <nav class="space-y-4">
        {RUST_PARTS.map((pt) => {
          const items = RUST_CURRICULUM.filter((c) => c.part === pt.part);
          return (
            <div>
              <div class="px-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1.5">
                第 {pt.part} 篇 · {pt.name}
              </div>
              <ul class="space-y-0.5">
                {items.map((item) => {
                  const isActive = item.slug === props.slug;
                  return (
                    <li>
                      <a
                        href={withBase(`/rust/${item.slug}`)}
                        aria-current={isActive ? 'page' : undefined}
                        class={`flex items-start gap-2 rounded-lg px-2.5 py-2 text-[13px] leading-snug transition-colors ${
                          isActive
                            ? 'bg-amber-500/12 text-amber-700 dark:text-amber-300 font-semibold border border-amber-500/25'
                            : 'text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-slate-800/60'
                        }`}
                      >
                        <span
                          data-rust-dot={item.slug}
                          class="mt-1 inline-block h-2 w-2 shrink-0 rounded-full bg-slate-300 dark:bg-slate-700"
                        />
                        <span class="flex-1">
                          <span class="font-mono text-[11px] opacity-60 mr-1">{item.chapterCode}</span>
                          {item.title}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          );
        })}
      </nav>
    </div>
  </div>

  <div class="lesson-grid mx-auto grid max-w-7xl grid-cols-1 lg:grid-cols-[270px_minmax(0,1fr)] gap-8 px-4 sm:px-6 py-8">
    <!-- Left Sidebar -->
    <aside class="lesson-sidebar hidden lg:block">
      <div id="rust-sidebar-scroll" class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-2 space-y-5">
        <div class="rounded-xl border border-slate-200/80 dark:border-slate-800 bg-white/60 dark:bg-slate-900/40 p-3.5">
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 mb-1.5">
            <span>Rust 实战书进度</span>
            <span id="rust-sidebar-progress-text" class="font-mono font-semibold text-amber-600 dark:text-amber-400">
              0 / {RUST_CURRICULUM.length}
            </span>
          </div>
          <div class="h-1.5 w-full rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
            <div id="rust-sidebar-progress-fill" class="h-full w-0 bg-amber-500 transition-all duration-300"></div>
          </div>
        </div>

        <nav class="space-y-4">
          {RUST_PARTS.map((pt) => {
            const items = RUST_CURRICULUM.filter((c) => c.part === pt.part);
            return (
              <div>
                <div class="px-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1.5">
                  第 {pt.part} 篇 · {pt.name}
                </div>
                <ul class="space-y-0.5">
                  {items.map((item) => {
                    const isActive = item.slug === props.slug;
                    return (
                      <li>
                        <a
                          href={withBase(`/rust/${item.slug}`)}
                          aria-current={isActive ? 'page' : undefined}
                          class={`group flex items-start gap-2 rounded-lg px-2.5 py-2 text-[13px] leading-snug transition-colors ${
                            isActive
                              ? 'bg-amber-500/12 text-amber-700 dark:text-amber-300 font-semibold border border-amber-500/25'
                              : 'text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100'
                          }`}
                        >
                          <span
                            data-rust-dot={item.slug}
                            class="mt-1 inline-block h-2 w-2 shrink-0 rounded-full bg-slate-300 dark:bg-slate-700"
                          />
                          <span class="flex-1">
                            <span class="font-mono text-[11px] opacity-60 mr-1">{item.chapterCode}</span>
                            {item.title}
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            );
          })}
        </nav>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="min-w-0 max-w-3xl">
      <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800/90">
        <div class="flex flex-wrap items-center gap-2 text-xs font-medium mb-4">
          <span class="inline-flex items-center rounded-full bg-amber-500/12 text-amber-700 dark:text-amber-300 px-2.5 py-1 border border-amber-500/25">
            第 {props.part} 篇 · {props.partName}
          </span>
          <span class="inline-flex items-center rounded-full bg-slate-200/70 dark:bg-slate-800 text-slate-600 dark:text-slate-300 px-2.5 py-1 font-mono">
            约 {props.readMinutes} 分钟 · 浏览器在线点读
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
          {props.chapterCode}：{props.title}
        </h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
          {props.subtitle}
        </p>

        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="rounded-xl border border-slate-200/80 dark:border-slate-800 bg-white/70 dark:bg-slate-900/50 p-3.5">
            <div class="text-slate-400 dark:text-slate-500 font-semibold uppercase tracking-wider text-[10px] mb-1.5">
              本章工程目标
            </div>
            <p class="text-slate-700 dark:text-slate-200 leading-relaxed">{props.engineeringGoal}</p>
          </div>
          <div class="rounded-xl border border-slate-200/80 dark:border-slate-800 bg-white/70 dark:bg-slate-900/50 p-3.5">
            <div class="text-slate-400 dark:text-slate-500 font-semibold uppercase tracking-wider text-[10px] mb-1.5">
              Rust 核心语法点
            </div>
            <div class="flex flex-wrap gap-1.5">
              {props.rustConcepts.map((item) => (
                <span class="rounded-md bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20 px-2 py-0.5 font-mono text-[11px]">
                  {item}
                </span>
              ))}
            </div>
          </div>
        </div>

        {props.quantLessonSlug && (
          <div class="mt-4 rounded-xl border border-emerald-500/25 bg-emerald-500/5 px-4 py-2.5 flex flex-wrap items-center justify-between gap-2 text-xs">
            <span class="text-slate-600 dark:text-slate-300">
              还没看懂背后的交易机制？先去交易主书建立直觉：
            </span>
            <a
              href={withBase(`/lessons/${props.quantLessonSlug}`)}
              class="font-semibold text-emerald-700 dark:text-emerald-300 hover:underline"
            >
              回到主书 · {props.quantLessonTitle} →
            </a>
          </div>
        )}
      </header>

      <article class="lesson-prose">
        <slot />
      </article>

      <footer class="mt-14 pt-8 border-t border-slate-200 dark:border-slate-800 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 p-5">
          <div>
            <div class="text-sm font-semibold text-slate-900 dark:text-white">
              吃透本章的 Rust 设计了吗？
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              无需本地配置环境，全部代码与设计思考均可在浏览器内完成
            </div>
          </div>
          <button
            id="rust-toggle-complete-btn"
            type="button"
            data-slug={props.slug}
            class="inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition-all cursor-pointer bg-amber-600 text-white hover:bg-amber-500"
          >
            标记本章已完成
          </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevChapter ? (
            <a
              href={withBase(`/rust/${prevChapter.slug}`)}
              class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white/60 dark:bg-slate-900/40 p-4 hover:border-amber-500/50 transition-colors"
            >
              <div class="text-xs text-slate-400 mb-1">← 上一章</div>
              <div class="font-semibold text-slate-900 dark:text-slate-100 group-hover:text-amber-600 dark:group-hover:text-amber-400">
                {prevChapter.chapterCode}：{prevChapter.title}
              </div>
            </a>
          ) : (
            <a
              href={withBase('/rust')}
              class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white/60 dark:bg-slate-900/40 p-4 hover:border-amber-500/50 transition-colors"
            >
              <div class="text-xs text-slate-400 mb-1">← 返回书二首页</div>
              <div class="font-semibold text-slate-900 dark:text-slate-100">
                查看全部 {RUST_CURRICULUM.length} 章 Rust 实战目录
              </div>
            </a>
          )}

          {nextChapter ? (
            <a
              href={withBase(`/rust/${nextChapter.slug}`)}
              class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white/60 dark:bg-slate-900/40 p-4 text-right hover:border-amber-500/50 transition-colors"
            >
              <div class="text-xs text-slate-400 mb-1">下一章 →</div>
              <div class="font-semibold text-slate-900 dark:text-slate-100 group-hover:text-amber-600 dark:group-hover:text-amber-400">
                {nextChapter.chapterCode}：{nextChapter.title}
              </div>
            </a>
          ) : (
            <a
              href={withBase('/')}
              class="group rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-4 text-right hover:border-emerald-500/60 transition-colors"
            >
              <div class="text-xs text-emerald-600 dark:text-emerald-400 mb-1">实战书完结 · 回到交易主书 →</div>
              <div class="font-semibold text-slate-900 dark:text-slate-100">
                返回《零基础量化交易交互指南》
              </div>
            </a>
          )}
        </div>
      </footer>
    </main>
  </div>

  <script>
    import { toggleRustChapterComplete } from '../lib/progress';
    import { initReaderLayout } from '../lib/readerControls';
    import { RUST_CURRICULUM } from '../data/rustCurriculum';

    initReaderLayout({
      validSlugs: RUST_CURRICULUM.map((c) => c.slug),
      getCompleted: (p) => p.completedRustChapters,
      onToggleComplete: toggleRustChapterComplete,
      sidebarScrollKey: 'quant-rust-sidebar-scroll',
      ids: {
        sidebarScroll: 'rust-sidebar-scroll',
        mobileBtn: 'rust-mobile-toc-btn',
        mobileDrawer: 'rust-mobile-toc-drawer',
        mobileClose: 'rust-mobile-toc-close',
        mobileBackdrop: 'rust-mobile-toc-backdrop',
        completeBtn: 'rust-toggle-complete-btn',
        progressText: 'rust-sidebar-progress-text',
        progressFill: 'rust-sidebar-progress-fill',
      },
      dotAttr: 'data-rust-dot',
      dotDatasetKey: 'rustDot',
      dotActiveClass: 'bg-amber-500',
      completeLabels: {
        done: '✓ 已完成本章（点击取消）',
        todo: '标记本章已完成',
      },
      completeClasses: {
        done: 'inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition-all cursor-pointer border border-amber-500/40 bg-amber-500/15 text-amber-700 dark:text-amber-300 hover:bg-amber-500/20',
        todo: 'inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition-all cursor-pointer bg-amber-600 text-white hover:bg-amber-500',
      },
    });
  </script>
</BaseLayout>
